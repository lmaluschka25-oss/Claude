# Copy to .env and adjust. All variables are optional; defaults work locally.
# Backend reads these (prefix VVC_). See backend/app/config.py for the full list.

# --- General ---
VVC_ENVIRONMENT=development
VVC_LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (JSON list also accepted).
VVC_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Vision pipeline ---
# "yolo" for real inference (needs weights + requirements-ml.txt), or "mock".
VVC_DETECTOR_BACKEND=mock
VVC_YOLO_MODEL_PATH=data/models/valorant.pt
VVC_YOLO_CONFIDENCE=0.35
VVC_YOLO_DEVICE=auto
# Process 1 of every N frames. Higher = faster, coarser timing.
VVC_FRAME_SAMPLE_STRIDE=6
# OCR for HUD text: "easyocr", "tesseract", or "off".
VVC_OCR_BACKEND=off

# --- Analysis defaults (overridable per request) ---
VVC_SIGHTING_TTL_SECONDS=12
VVC_MOVEMENT_SPEED_NORM=0.13
VVC_SITE_PRESSURE_RADIUS=0.22

# --- Frontend (Vite) ---
# Base URL the React app uses to reach the API.
VITE_API_BASE=http://localhost:8000/api
