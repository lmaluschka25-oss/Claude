# Copy to .env and adjust. All variables are optional; defaults work locally.
# Backend reads these (prefix VVC_). See backend/app/config.py for the full list.

# --- General ---
VVC_ENVIRONMENT=development
VVC_LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (JSON list also accepted).
VVC_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Vision pipeline ---
# Detector backend:
#   "minimap" = classical CV, reads red enemy dots off the minimap (NO model needed)
#   "yolo"    = trained model, full detection incl. agents (needs weights + requirements-ml.txt)
#   "mock"    = synthetic demo data
VVC_DETECTOR_BACKEND=mock
VVC_YOLO_MODEL_PATH=data/models/valorant.pt
VVC_YOLO_CONFIDENCE=0.35
VVC_YOLO_DEVICE=auto
# Process 1 of every N frames. Higher = faster, coarser timing.
VVC_FRAME_SAMPLE_STRIDE=6
# OCR for HUD text (timer/score → round segmentation): "easyocr" / "tesseract" / "off".
VVC_OCR_BACKEND=off

# --- Minimap calibration (for VVC_DETECTOR_BACKEND=minimap) ---
# The minimap rectangle as fractions of the frame. Tune with the
# /api/matches/{id}/minimap-preview endpoint until the green box sits exactly
# on the minimap and red circles land on the enemy markers.
VVC_MINIMAP_X_FRAC=0.012
VVC_MINIMAP_Y_FRAC=0.012
VVC_MINIMAP_W_FRAC=0.182
VVC_MINIMAP_H_FRAC=0.324
VVC_MINIMAP_ROTATION=0
VVC_MINIMAP_FLIP_X=false
# Red marker color gate (HSV). Strict by default so warm background textures
# (translucent big map over the world) are ignored. If real enemy dots are
# missed, LOWER sat/val; if background noise is picked up, RAISE them.
# Hue wraps: a pixel counts as red if hue <= HUE_LO or hue >= HUE_HI.
VVC_MINIMAP_ENEMY_SAT_MIN=150
VVC_MINIMAP_ENEMY_VAL_MIN=150
VVC_MINIMAP_ENEMY_HUE_LO=6
VVC_MINIMAP_ENEMY_HUE_HI=174
VVC_MINIMAP_MIN_AREA=3
VVC_MINIMAP_MAX_AREA=600

# --- Analysis defaults (overridable per request) ---
VVC_SIGHTING_TTL_SECONDS=12
VVC_MOVEMENT_SPEED_NORM=0.13
VVC_SITE_PRESSURE_RADIUS=0.22

# --- Frontend (Vite) ---
# Base URL the React app uses to reach the API.
VITE_API_BASE=http://localhost:8000/api
