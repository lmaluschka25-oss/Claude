# ---- AI Vision Dashboard – Beispiel-Konfiguration ----
# Kopiere diese Datei zu ".env" und passe die Werte an.

# Claude API Key. Ohne Key laeuft das Tool im heuristischen Modus (komplett ohne LLM).
ANTHROPIC_API_KEY=

# Modell: Standard ist guenstig & schnell. Fuer hoechste Qualitaet: claude-opus-4-8
AIVD_MODEL=claude-haiku-4-5

# Pfad zu tesseract.exe, falls nicht im PATH (wird sonst automatisch gesucht)
# AIVD_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR-Sprache(n): "eng" oder z.B. "deu+eng" (deutsche Sprachdatei muss installiert sein)
AIVD_OCR_LANG=eng

# Intervalle in Sekunden
AIVD_CAPTURE_INTERVAL=1.0
AIVD_AI_INTERVAL=25

# Welcher Monitor (1 = Hauptbildschirm)
AIVD_MONITOR_INDEX=1
